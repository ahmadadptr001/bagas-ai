# ============================================================
#  Konfigurasi bagas-ai
#  Salin file ini menjadi ".env" lalu isi nilainya — SEMUANYA opsional.
#    cp .env.example .env   (Linux/Mac)
#    copy .env.example .env (Windows)
# ============================================================
#
# bagas-ai punya DUA jalur model, dan bedanya nyata:
#
#   (web)  web/*    — lewat BROWSER, memakai akun yang sudah kamu pakai
#                     sehari-hari. TANPA API key: login cukup SEKALI di jendela
#                     browser saat kamu memilih model lewat /model, sesinya
#                     tersimpan di ~/.bagasai/browser. Gratis, tapi jendela
#                     browser harus hidup dan mode berpikirnya diatur dengan
#                     MENGKLIK tombol di situsnya.
#   (API)  nvidia/*  — lewat endpoint NVIDIA. Butuh NVIDIA_API_KEY (gratis di
#                     https://build.nvidia.com), tak butuh browser sama sekali,
#                     jauh lebih cepat, dan tool dipanggil dengan
#                     function-calling asli.
#   (API)  openrouter/*  — lewat OpenRouter. Butuh OPENROUTER_API_KEY
#                     (https://openrouter.ai/keys), sama-sama tanpa browser,
#                     function-calling asli; mode berpikir dikirim sebagai
#                     {"reasoning": {"enabled": true}} dengan stream=true.
#
# Keduanya bisa dipakai bergantian lewat /model dalam satu sesi. TAK ADA yang
# wajib diisi di berkas ini: tanpa API key, model (web) tetap jalan penuh.

# --- Model bawaan ---
# (web): web/glm (default) · web/kimi · web/qwen · web/gemini · web/chatgpt
# (API): nvidia/nemotron · nvidia/muse · openrouter/ox-alpha  <- perlu API key
# Bisa diganti kapan saja lewat /model; pilihan terakhir otomatis tersimpan.
CHAT_MODEL=web/glm

# --- Model (API) NVIDIA (opsional) ---
# Kosongkan bila kamu hanya memakai model (web): entri nvidia/* tetap tampil di
# /model tapi ditolak dengan keterangan, bukan gagal diam-diam.
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model yang dipakai bila jalur NVIDIA jalan tanpa menyebut modelnya (jaring
# pengaman). SENGAJA nemotron: TERUKUR 2026-08-23 deepseek-v4-flash butuh
# 106-169 detik sebelum kata pertama keluar, terlalu lambat untuk jadi bawaan.
# NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Model (API) OpenRouter (opsional) ---
# Dipakai model openrouter/* (mis. oxalpha -> stealth/ox-alpha). Tanpa key ini,
# entri openrouter/* tetap tampil di /model tapi ditolak dengan keterangan.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Setelan di bawah HANYA berlaku untuk model (API); jalur (web) tak memakai
# satu pun (batas waktunya ada di connector-nya masing-masing).
# TEMPERATURE=1.0
# TOP_P=0.95
# Dua anggaran waktu yang SENGAJA DIPISAH — jangan disatukan lagi.
# BAGASAI_TTFT_TIMEOUT: sabar, menunggu token PERTAMA (model bisa mengantre).
# STREAM_STALL_TIMEOUT: ketat, jeda antar-token SESUDAH token pertama tiba.
# BAGASAI_TTFT_TIMEOUT=300
# STREAM_STALL_TIMEOUT=45
# Total anggaran menunggu saat endpoint throttle sebelum benar-benar menyerah
# (free tier NVIDIA sekitar 40 permintaan/menit).
# RETRY_MAX_SECONDS=300
# Anggaran panggilan tool dalam SATU giliran, & berapa kali bagas-ai boleh
# menaikkan mode berpikir sendiri saat model terdeteksi mengulang/kosong.
# MAX_TOOL_CALLS=40
# MAX_ESCALATIONS=2

# --- Connector browser ---
# Butuh Playwright (dipasang otomatis oleh installer):
#   pip install playwright && playwright install chromium
# Jendela Chrome MUNCUL sekali untuk login lalu disembunyikan; chat & jawaban
# tampil di TERMINAL. Jendela tetap ada (bukan headless) karena Cloudflare
# menolak sesi headless — inilah default yang andal.
# CONNECTOR_HEADLESS=true          # paksa headless; hanya utk situs tanpa Cloudflare
# CONNECTOR_SHOW=true              # tampilkan jendela terus (mengamati prosesnya)
# CONNECTOR_BROWSER_CHANNEL=chrome # Chrome asli (default); "" -> Chromium bawaan
# Tiap sesi bagas-ai membuat 1 percakapan baru di situs. Batas ini menyisakan N
# percakapan TERBARU buatan bagas-ai; sisanya dihapus otomatis (chat pribadimu
# TIDAK disentuh). 0 = jangan hapus otomatis; bersihkan manual lewat /web.
# CONNECTOR_KEEP_CHATS=20

# --- Bot Telegram (opsional; hanya perlu jika menjalankan mode telegram) ---
# Dapatkan token dari @BotFather di Telegram.
TELEGRAM_BOT_TOKEN=
# ID Telegram yang BOLEH mengontrol bagas-ai (pisah koma). WAJIB diisi demi
# keamanan: lewat Telegram bagas-ai bisa menjalankan perintah & menulis file di
# laptopmu. Kosongkan -> pengirim pertama otomatis jadi pemilik (lalu ID-nya
# diberitahukan agar bisa kamu tempel di sini). Cek ID-mu via @userinfobot.
TELEGRAM_ALLOWED_IDS=

# --- Pengaturan agent ---
# Batas iterasi loop tool per giliran.
MAX_TOOL_ITERATIONS=8

# --- Keamanan eksekusi kode ---
# true  = tool eksekusi kode/perintah aktif (hati-hati!)
# false = matikan total eksekusi kode
ALLOW_CODE_EXEC=true
# Timeout eksekusi kode dalam detik.
CODE_EXEC_TIMEOUT=30
